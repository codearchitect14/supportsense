ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://supportsense:supportsense@localhost:5432/supportsense
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUESTS_PER_MINUTE=15
GEMINI_REQUESTS_PER_DAY=500

LLM_MAX_RESPONSE_TOKENS=300
LLM_HISTORY_MAX_TURNS=4
LLM_MAX_CONTEXT_SNIPPETS=3

RETRIEVAL_TOP_K=5
KB_DIRECT_SIMILARITY_THRESHOLD=0.88
CONVERSATION_SUMMARY_TRIGGER_TURNS=12

SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=500

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

TTS_VOICE=en-US-AriaNeural
VOICE_PARTIAL_TRANSCRIBE_SECONDS=2.0
VOICE_MAX_UTTERANCE_SECONDS=30.0

CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_DEFAULT=60/minute
